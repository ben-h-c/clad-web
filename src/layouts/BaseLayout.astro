---
import "~/styles/global.css";
import "~/styles/theme-skins.css";
import Masthead from "~/components/Masthead.astro";
import ThemeSkinBar from "~/components/ThemeSkinBar.astro";
import SiteTips from "~/components/SiteTips.astro";
import ThemeCoachmark from "~/components/ThemeCoachmark.astro";
import { APP_STORE_LIVE } from "~/lib/app-store";
import { getSessionUser, getPrefs, type ThemePref } from "~/lib/user-data";
import {
  showBillingPromo,
  parseStageSkin,
  parseStageView,
  STAGE_SKIN_COOKIE,
  STAGE_VIEW_COOKIE,
} from "~/lib/access";
import { OG_VERSIONS } from "~/lib/ogCard";
import { env } from "cloudflare:workers";

interface Props {
  title: string;
  description?: string;
  /** Social-preview overrides. Default to the page title/description. */
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogType?: "website" | "article";
  /** Keep this page out of search indexes (auth/utility pages). */
  noindex?: boolean;
  /** Extra JSON-LD object(s) to emit in <head> (e.g. NewsArticle). */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = "CladFacts — fact-checked headlines, graded for accuracy and political lean.",
  ogTitle,
  ogDescription,
  ogImage,
  ogType = "website",
  noindex = false,
  jsonLd,
} = Astro.props;

const site = Astro.site ?? new URL("https://cladfacts.com");
// Canonical URLs always carry a trailing slash (except file-like paths), so
// /foo and /foo/ never compete in search indexes.
const path = Astro.url.pathname;
const normalizedPath =
  /\.[a-z0-9]+$/i.test(path) || path === "/" || path.endsWith("/") ? path : path + "/";
const canonical = new URL(normalizedPath, site).href;
const metaDescription = description.replace(/\s+/g, " ").trim();
const shareTitle = ogTitle ?? title;
const shareDescription = (ogDescription ?? description).replace(/\s+/g, " ").trim();
// Resolve the share image to an absolute URL (relative paths -> site origin).
// Pages without their own image fall back to a branded card so link previews
// (X/Twitter, etc.) always show a large image.
// Signed-in account theme (light/dark) — applied before paint to avoid flash.
// Guests use localStorage (masthead toggle); if unset, dark is the default.
// Admin desk is always dark (editor basic-auth + console), independent of
// the public reading preference.
const isAdminPath = path === "/admin" || path.startsWith("/admin/");
let accountTheme: ThemePref | null = null;
if (!isAdminPath) {
  try {
    const u = await getSessionUser(Astro.request.headers);
    if (u) {
      const prefs = await getPrefs(u.id);
      accountTheme = prefs.theme === "light" ? "light" : "dark";
    }
  } catch {
    accountTheme = null;
  }
}
// SSR default dark so first paint matches FOUC script for guests without localStorage.
const htmlTheme: ThemePref = isAdminPath ? "dark" : accountTheme ?? "dark";
const themeColor = htmlTheme === "dark" ? "#1C1C1E" : "#F7F5F0";

// Share image: match the viewer's current theme so scorecards look right when
// shared from a signed-in session (guests default dark; client toggle updates meta).
// Default brand card: version-bust so iMessage/etc. re-unfurl after redesigns.
const shareImageRaw = ogImage ?? `/og/brand.png?v=${OG_VERSIONS.post}`;
const shareImageUrl = new URL(shareImageRaw, site);
if (!shareImageUrl.searchParams.has("theme")) {
  shareImageUrl.searchParams.set("theme", htmlTheme);
}
if (!shareImageUrl.searchParams.has("v") && shareImageRaw.includes("/og/brand")) {
  shareImageUrl.searchParams.set("v", OG_VERSIONS.post);
}
const shareImage = shareImageUrl.href;

// Site-wide structured data: the publisher + a searchable website. Page-specific
// schema (e.g. NewsArticle) is passed in via the jsonLd prop.
const SITE_URL = site.origin;
const orgLd = {
  "@context": "https://schema.org",
  "@type": "NewsMediaOrganization",
  name: "CladFacts",
  alternateName: "Clad",
  legalName: "CladFacts LLC",
  url: SITE_URL,
  logo: `${SITE_URL}/favicon.svg`,
  description: "AI-assisted fact-checking that grades news for accuracy and rates its political bias.",
  publishingPrinciples: `${SITE_URL}/how-it-works/`,
  factCheckingPolicy: `${SITE_URL}/methodology/`,
  correctionsPolicy: `${SITE_URL}/corrections/`,
  // sameAs grows as handles are reserved; App Store is live (id6781372681).
  sameAs: [
    "https://apps.apple.com/app/id6781372681",
  ],
  founder: {
    "@type": "Person",
    name: "Ben Cody",
    url: `${SITE_URL}/about/#editor`,
  },
};
const siteLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "CladFacts",
  alternateName: "Clad",
  url: SITE_URL,
  potentialAction: {
    "@type": "SearchAction",
    target: `${SITE_URL}/search/?q={search_term_string}`,
    "query-input": "required name=search_term_string",
  },
};
const ldBlocks = [orgLd, siteLd, ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
const billingOn = showBillingPromo();
const isStaging = env.ENVIRONMENT === "staging";
const robotsContent =
  noindex || isStaging ? "noindex,nofollow" : "max-image-preview:large";
const skinParam = isStaging ? Astro.url.searchParams.get("skin") : null;
const skin = isStaging
  ? parseStageSkin(skinParam ?? Astro.cookies.get(STAGE_SKIN_COOKIE)?.value)
  : null;
const viewParam = isStaging ? Astro.url.searchParams.get("view") : null;
const stageView = isStaging
  ? viewParam === "live"
    ? null
    : parseStageView(viewParam ?? Astro.cookies.get(STAGE_VIEW_COOKIE)?.value)
  : null;
---
<!doctype html>
<html
  lang="en"
  data-theme={htmlTheme}
  data-account-theme={accountTheme ? "1" : "0"}
  data-force-theme={isAdminPath ? "dark" : undefined}
  data-billing={billingOn ? "1" : "0"}
  data-skin={skin || undefined}
  data-stage-view={stageView || undefined}
>
  <head>
    <meta charset="utf-8" />
    <!-- The iOS app injects window.__cladNative at document start. Flag the
         document as in-app so CSS can hide the web/Stripe purchase surfaces
         and reveal the app-only "Go Premium" button, which routes to the
         native StoreKit paywall via the cladPurchase bridge (Apple IAP).
         Purchase surfaces stay inert while data-billing="0". -->
    <script is:inline>
      if (window.__cladNative) {
        document.documentElement.classList.add('clad-app');
        document.addEventListener('click', function (e) {
          if (document.documentElement.getAttribute('data-billing') !== '1') return;
          var b = e.target.closest && e.target.closest('.js-app-purchase');
          if (b && window.webkit && window.webkit.messageHandlers && window.webkit.messageHandlers.cladPurchase) {
            e.preventDefault();
            window.webkit.messageHandlers.cladPurchase.postMessage({});
          }
        });
      } else if (
        location.hostname === 'mail.cladfacts.com' &&
        /iPhone|iPad|iPod/i.test(navigator.userAgent || '')
      ) {
        // Email click-throughs land here so Yahoo/Mail do not Universal-Link
        // the apex host. If the App Store app is installed, hand off via the
        // cladfacts://post/{slug} scheme it already routes to the article.
        // No app → this page stays put (the article / how-it-works HTML).
        var post = (location.pathname || '').match(/^\/posts\/([^/]+)\/?$/);
        if (post) {
          // Custom scheme — the App Store binary already maps this to /posts/{slug}/.
          // Universal Links on this host need a newer app entitlement.
          window.location.href = 'cladfacts://post/' + post[1];
        }
      }
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content={themeColor} />
    <!-- Prefetch common next hops so back-to-home / menu nav feels instant. -->
    {!isAdminPath && (
      <Fragment>
        <link rel="prefetch" href="/" as="document" />
        <link rel="prefetch" href="/discover/" as="document" />
        <link rel="prefetch" href="/search/" as="document" />
        <script is:inline type="speculationrules">
{"prefetch":[{"source":"list","urls":["/","/discover/","/search/","/trends/","/good-news/"],"eagerness":"moderate"}],"prerender":[{"source":"list","urls":["/"],"eagerness":"conservative"}]}
        </script>
      </Fragment>
    )}
    <!-- Refresh always lands at the top of the current page. Browsers otherwise
         restore the prior scroll offset (and site smooth-scroll can make that
         look like a long jump). Back/forward navigation is left alone. -->
    <script is:inline>
      (function () {
        function isReload() {
          try {
            var n = performance.getEntriesByType("navigation")[0];
            if (n && n.type === "reload") return true;
          } catch (e) {}
          try {
            if (performance.navigation && performance.navigation.type === 1) return true;
          } catch (e2) {}
          return false;
        }
        if (!isReload()) return;
        try {
          if ("scrollRestoration" in history) history.scrollRestoration = "manual";
        } catch (e3) {}
        function toTop() {
          var html = document.documentElement;
          var prev = html.style.scrollBehavior;
          html.style.scrollBehavior = "auto";
          try {
            window.scrollTo({ top: 0, left: 0, behavior: "instant" });
          } catch (e4) {
            window.scrollTo(0, 0);
          }
          html.scrollTop = 0;
          if (document.body) document.body.scrollTop = 0;
          html.style.scrollBehavior = prev || "";
        }
        toTop();
        document.addEventListener("DOMContentLoaded", toTop);
        window.addEventListener("load", toTop);
        // Safari/Chrome can re-apply the saved offset after load.
        window.addEventListener("pageshow", function () {
          if (isReload()) toTop();
        });
        setTimeout(toTop, 0);
        setTimeout(toTop, 50);
        setTimeout(toTop, 200);
      })();
    </script>
    <!-- Theme before first paint + global toggle handler (capture phase so it
         always wins over menu chrome stacking / other click handlers). -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        function applyTheme(next, opts) {
          var dark = next === "dark";
          var skipStorage = opts && opts.skipStorage;
          if (dark) {
            root.setAttribute("data-theme", "dark");
            root.classList.add("theme-dark");
          } else {
            root.setAttribute("data-theme", "light");
            root.classList.remove("theme-dark");
          }
          if (!skipStorage) {
            try { localStorage.setItem("clad_theme", dark ? "dark" : "light"); } catch (e) {}
          }
          var tc = document.querySelector('meta[name="theme-color"]');
          if (tc) tc.setAttribute("content", dark ? "#1C1C1E" : "#F7F5F0");
          root.style.colorScheme = dark ? "dark" : "light";
          var btn = document.getElementById("theme-toggle");
          if (btn) {
            btn.setAttribute("aria-pressed", dark ? "true" : "false");
            btn.title = dark ? "Switch to light reading" : "Switch to dark reading";
            btn.setAttribute("aria-label", dark ? "Switch to light reading" : "Switch to dark reading");
          }
          // Keep OG scorecard previews aligned with the active theme.
          try {
            var theme = dark ? "dark" : "light";
            document.querySelectorAll('meta[property="og:image"], meta[name="twitter:image"]').forEach(function (m) {
              var href = m.getAttribute("content");
              if (!href || href.indexOf("/og/") === -1) return;
              try {
                var u = new URL(href, location.origin);
                u.searchParams.set("theme", theme);
                m.setAttribute("content", u.toString());
              } catch (e2) {}
            });
          } catch (e3) {}
        }
        window.__cladApplyTheme = applyTheme;
        try {
          // Admin desk always dark — do not follow public light preference.
          var forced = root.getAttribute("data-force-theme");
          if (forced === "dark" || forced === "light") {
            applyTheme(forced, { skipStorage: true });
          } else {
            var fromAccount = root.getAttribute("data-account-theme") === "1";
            var t = root.getAttribute("data-theme");
            if (fromAccount && (t === "dark" || t === "light")) {
              applyTheme(t);
            } else {
              t = localStorage.getItem("clad_theme");
              // Explicit toggle/account choice wins; otherwise default to dark.
              if (t === "dark" || t === "light") applyTheme(t);
              else applyTheme("dark");
            }
          }
        } catch (e) {
          applyTheme("dark", { skipStorage: true });
        }
        // Capture phase so masthead title / menu listeners cannot steal the click.
        document.addEventListener(
          "click",
          function (e) {
            var btn = e.target && e.target.closest && e.target.closest("#theme-toggle");
            if (!btn) return;
            // Admin is locked to dark — ignore the public theme toggle.
            if (root.getAttribute("data-force-theme") === "dark") {
              e.preventDefault();
              e.stopPropagation();
              applyTheme("dark", { skipStorage: true });
              return;
            }
            e.preventDefault();
            e.stopPropagation();
            var cur = root.getAttribute("data-theme") === "dark" || root.classList.contains("theme-dark");
            var next = cur ? "light" : "dark";
            applyTheme(next);
            var mast = document.querySelector(".masthead");
            if (mast && mast.getAttribute("data-signed-in") === "1") {
              fetch("/api/me/preferences", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                credentials: "same-origin",
                body: JSON.stringify({ theme: next }),
              }).catch(function () {});
            }
          },
          true
        );
      })();
    </script>
    <meta name="google-site-verification" content="OYUpYStZyOvXegnN47Cnf17Ay6-ZtZSQtGrTjwBW5Zs" />
    <meta name="description" content={metaDescription} />
    {/* Large image previews in Google Discover/Top Stories; per-post OG
        images are 1200×630 and grade-free for restricted readers. */}
    <meta name="robots" content={robotsContent} />
    {/* iOS Safari smart app banner — the native install prompt for the
        CladFacts app (same listing as the footer badge). app-argument deep
        links the app to the page being viewed. Gated on APP_STORE_LIVE so we
        never advertise a listing that isn't publicly up yet. */}
    {APP_STORE_LIVE && (
      <meta name="apple-itunes-app" content={`app-id=6781372681, app-argument=${Astro.url.href}`} />
    )}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="alternate" type="application/rss+xml" title="CladFacts — latest reports" href="/rss.xml" />
    <link rel="preconnect" href="https://img.youtube.com" />
    <link rel="preconnect" href="https://i.ytimg.com" />
    <title>{title}</title>

    <!-- Open Graph / social link previews -->
    <meta property="og:site_name" content="CLAD" />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={shareTitle} />
    <meta property="og:description" content={shareDescription} />
    {shareImage && <meta property="og:image" content={shareImage} />}
    {shareImage && <meta property="og:image:secure_url" content={shareImage} />}
    {shareImage && <meta property="og:image:type" content="image/png" />}
    {shareImage && <meta property="og:image:width" content="1200" />}
    {shareImage && <meta property="og:image:height" content="630" />}
    {shareImage && <meta property="og:image:alt" content={shareTitle} />}

    <meta name="twitter:card" content={shareImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={shareTitle} />
    <meta name="twitter:description" content={shareDescription} />
    {shareImage && <meta name="twitter:image" content={shareImage} />}
    {shareImage && <meta name="twitter:image:alt" content={shareTitle} />}

    {ldBlocks.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}
    <slot name="head" />
  </head>
  <body>
    {isStaging && <ThemeSkinBar currentSkin={skin} currentView={stageView} />}
    {isStaging && (
      <script is:inline>
        (function () {
          var box = document.getElementById("clad-allow-spend");
          if (!box) return;
          try { box.checked = sessionStorage.getItem("clad_allow_spend") === "1"; } catch (e) {}
          box.addEventListener("change", function () {
            try { sessionStorage.setItem("clad_allow_spend", box.checked ? "1" : "0"); } catch (e) {}
          });
          var orig = window.fetch;
          window.fetch = function (input, init) {
            if (!box.checked) return orig.call(this, input, init);
            init = init ? Object.assign({}, init) : {};
            var headers = new Headers(init.headers || {});
            headers.set("X-Clad-Allow-Spend", "1");
            init.headers = headers;
            return orig.call(this, input, init);
          };
        })();
        document.addEventListener("click", function (e) {
          var root = document.documentElement;
          var skin = root.getAttribute("data-skin");
          var view = root.getAttribute("data-stage-view");
          if (!skin && !view) return;
          var a = e.target && e.target.closest && e.target.closest("a[href]");
          if (!a || a.getAttribute("aria-current") === "true") return;
          if (a.hostname && a.hostname !== location.hostname) return;
          try {
            var u = new URL(a.getAttribute("href"), location.origin);
            if (u.origin !== location.origin) return;
            if (skin && !u.searchParams.has("skin")) u.searchParams.set("skin", skin);
            if (view && !u.searchParams.has("view")) u.searchParams.set("view", view);
            a.setAttribute("href", u.pathname + u.search + u.hash);
          } catch (err) {}
        });
      </script>
    )}
    <a class="skip-link" href="#main">Skip to content</a>
    {/* Optional decorative stage behind the page (usually muted in soft UI). */}
    <div class="living-bg" aria-hidden="true">
      <span class="living-bg__orb living-bg__orb--a"></span>
      <span class="living-bg__orb living-bg__orb--b"></span>
      <span class="living-bg__orb living-bg__orb--c"></span>
      <span class="living-bg__orb living-bg__orb--d"></span>
      <span class="living-bg__spark living-bg__spark--1"></span>
      <span class="living-bg__spark living-bg__spark--2"></span>
      <span class="living-bg__spark living-bg__spark--3"></span>
      <span class="living-bg__spark living-bg__spark--4"></span>
      <span class="living-bg__spark living-bg__spark--5"></span>
      <span class="living-bg__grid"></span>
    </div>
    {Astro.url.pathname.startsWith("/posts/") && (
      <>
        <div class="read-progress" aria-hidden="true"><span class="read-progress__bar" id="read-progress-bar"></span></div>
        <script is:inline>
          (() => {
            var bar = document.getElementById("read-progress-bar");
            if (!bar || matchMedia("(prefers-reduced-motion: reduce)").matches) return;
            var ticking = false;
            var update = () => {
              ticking = false;
              var doc = document.documentElement;
              var max = doc.scrollHeight - innerHeight;
              bar.style.width = (max > 0 ? Math.min(100, (scrollY / max) * 100) : 0) + "%";
            };
            addEventListener("scroll", () => {
              if (!ticking) { ticking = true; requestAnimationFrame(update); }
            }, { passive: true });
            update();
          })();
        </script>
      </>
    )}
    <div class="shell">
      <Masthead theme={htmlTheme === "light" ? "light" : "dark"} />
      <main id="main">
        <slot />
      </main>
      <footer class="colophon">
        <nav class="colophon__legal" aria-label="Site footer">
          <a href="/about/">About</a>
          <span class="colophon__dot" aria-hidden="true">·</span>
          <a href="/privacy/">Privacy</a>
          <span class="colophon__dot" aria-hidden="true">·</span>
          <a href="/terms/">Terms</a>
        </nav>
        <p>© {new Date().getFullYear()} CladFacts LLC</p>
      </footer>
    </div>
    {!isAdminPath && !isStaging && <SiteTips />}
    {!isAdminPath && !isStaging && <ThemeCoachmark />}
    {/* Privacy-first first-party analytics: aggregate page/video signals only.
        Cookieless; honors DNT/GPC; no account/PII. See /privacy/ and /admin/analytics/. */}
    {!isAdminPath && (
      <script src="/js/clad-analytics.js" defer></script>
    )}
  </body>
</html>
