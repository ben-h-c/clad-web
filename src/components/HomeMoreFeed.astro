---
/**
 * Bottom home feed — randomized (day-seeded) articles, 16 per page, Load more.
 */
import ReportCard from "~/components/ReportCard.astro";
import type { CollectionEntry } from "astro:content";
import { HOME_MORE_PAGE_SIZE } from "~/lib/homeMoreFeed";

interface Props {
  posts: CollectionEntry<"posts">[];
  seed: string;
  total: number;
  nextOffset: number;
  hasMore: boolean;
  locked?: boolean;
}

const {
  posts,
  seed,
  total,
  nextOffset,
  hasMore,
  locked = false,
} = Astro.props;
---
{
  posts.length > 0 && (
    <section
      class="home-more-feed feed"
      id="home-more-feed"
      aria-labelledby="home-more-feed-title"
      data-home-more
      data-seed={seed}
      data-offset={nextOffset}
      data-has-more={hasMore ? "1" : "0"}
      data-total={total}
      data-page-size={HOME_MORE_PAGE_SIZE}
      data-locked={locked ? "1" : "0"}
    >
      <div class="feed__head">
        <h2 class="feed__title" id="home-more-feed-title">Keep reading</h2>
        <span class="category__more home-more-feed__count" data-home-more-count>
          {Math.min(posts.length, total)} of {total.toLocaleString("en-US")}
        </span>
      </div>
      <div class="rule rule--double" aria-hidden="true"></div>
      <p class="home-more-feed__lead dateline">
        A shuffled mix of graded reports you might care about — fresh each day.
      </p>
      <div class="home-more-feed__grid" data-home-more-grid>
        {posts.map((p) => (
          <ReportCard post={p} locked={locked} />
        ))}
      </div>
      <div class="home-more-feed__footer" data-home-more-footer>
        {hasMore ? (
          <button type="button" class="home-more-feed__more" data-home-more-btn>
            Load more
          </button>
        ) : (
          <p class="home-more-feed__end dateline">You’re caught up on today’s shuffle.</p>
        )}
        <div class="home-more-feed__sentinel" data-home-more-sentinel aria-hidden="true"></div>
      </div>
    </section>
  )
}

<script is:inline>
  (() => {
    const root = document.querySelector("[data-home-more]");
    if (!root) return;
    const grid = root.querySelector("[data-home-more-grid]");
    const btn = root.querySelector("[data-home-more-btn]");
    const countEl = root.querySelector("[data-home-more-count]");
    const footer = root.querySelector("[data-home-more-footer]");
    const sentinel = root.querySelector("[data-home-more-sentinel]");
    if (!grid || !footer) return;

    let loading = false;
    let offset = parseInt(root.getAttribute("data-offset") || "0", 10) || 0;
    let hasMore = root.getAttribute("data-has-more") === "1";
    const seed = root.getAttribute("data-seed") || "";
    const pageSize = parseInt(root.getAttribute("data-page-size") || "25", 10) || 25;
    const total = parseInt(root.getAttribute("data-total") || "0", 10) || 0;
    const locked = root.getAttribute("data-locked") === "1";

    function esc(s) {
      return String(s || "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;");
    }

    function leanChip(score) {
      if (score == null || locked) return "";
      if (score === 0) return '<span class="report-card__chip report-card__chip--lean">Center</span>';
      const side = score < 0 ? "L" : "R";
      return (
        '<span class="report-card__chip report-card__chip--lean">' +
        Math.abs(score) +
        "% " +
        side +
        "</span>"
      );
    }

    function gradeChip(letter) {
      if (!letter || locked) {
        return locked
          ? '<span class="report-card__chip report-card__chip--lock grade-lock">Unlock free</span>'
          : "";
      }
      const tier = String(letter).charAt(0).toUpperCase();
      const tierClass =
        tier === "A"
          ? "grade--good"
          : tier === "B"
            ? "grade--b"
            : tier === "C"
              ? "grade--mid"
              : "grade--bad";
      return (
        '<span class="report-card__chip report-card__chip--grade">' +
        '<span class="letter-grade letter-grade--badge ' +
        tierClass +
        '">' +
        esc(letter) +
        "</span></span>"
      );
    }

    function formatDate(iso) {
      try {
        const d = new Date(iso);
        return d.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });
      } catch {
        return "";
      }
    }

    function cardHtml(p) {
      const thumb = p.thumbnail || "";
      const fx = typeof p.thumbFocusX === "number" ? p.thumbFocusX : 50;
      const fy = typeof p.thumbFocusY === "number" ? p.thumbFocusY : 40;
      const focus = fx + "% " + fy + "%";
      const hq =
        p.videoId && thumb
          ? "https://img.youtube.com/vi/" + encodeURIComponent(p.videoId) + "/hqdefault.jpg"
          : "";
      const onerr = hq
        ? " this.onerror=null;this.src='" + hq.replace(/'/g, "") + "';"
        : "";
      const chips =
        '<div class="report-card__media-chips">' +
        (locked ? gradeChip(null) : gradeChip(p.letterGrade) + leanChip(p.leanScore)) +
        "</div>";
      const source = esc(p.sourceTitle || p.sourceHost || "");
      const meta = esc(formatDate(p.publishedAt)) + (source ? " · " + source : "");
      const summary = p.summary
        ? '<p class="report-card__summary">' + esc(p.summary) + "</p>"
        : "";

      if (thumb && p.mediaStyle !== "text") {
        return (
          '<article class="report-card report-card--card report-card--media" data-media-style="band" style="--thumb-focus: ' +
          focus +
          '">' +
          '<a class="report-card__link" href="/posts/' +
          esc(p.slug) +
          '/" draggable="false">' +
          '<div class="report-card__photo"><img src="' +
          esc(thumb) +
          '" alt="" width="640" height="360" loading="lazy" decoding="async" style="object-position: ' +
          focus +
          '"' +
          (onerr ? ' onerror="' + onerr + '"' : "") +
          "></div>" +
          '<div class="report-card__media-body">' +
          chips +
          '<h3 class="report-card__headline">' +
          esc(p.headline) +
          "</h3>" +
          '<p class="report-card__meta">' +
          meta +
          "</p>" +
          summary +
          "</div></a></article>"
        );
      }
      return (
        '<article class="report-card report-card--card report-card--text">' +
        '<a class="report-card__link" href="/posts/' +
        esc(p.slug) +
        '/" draggable="false">' +
        '<div class="report-card__body">' +
        chips +
        '<h3 class="report-card__headline">' +
        esc(p.headline) +
        "</h3>" +
        '<p class="report-card__meta">' +
        meta +
        "</p>" +
        summary +
        "</div></a></article>"
      );
    }

    function updateCount(shown) {
      if (countEl) {
        countEl.textContent =
          Math.min(shown, total).toLocaleString("en-US") +
          " of " +
          total.toLocaleString("en-US");
      }
    }

    function setFooter() {
      if (!hasMore) {
        footer.innerHTML =
          '<p class="home-more-feed__end dateline">You’re caught up on today’s shuffle.</p>';
        return;
      }
      if (!footer.querySelector("[data-home-more-btn]")) {
        footer.innerHTML =
          '<button type="button" class="home-more-feed__more" data-home-more-btn>Load more</button>' +
          '<div class="home-more-feed__sentinel" data-home-more-sentinel aria-hidden="true"></div>';
        const b = footer.querySelector("[data-home-more-btn]");
        if (b) b.addEventListener("click", loadMore);
        observe();
      }
    }

    async function loadMore() {
      if (loading || !hasMore) return;
      loading = true;
      const b = footer.querySelector("[data-home-more-btn]");
      if (b) {
        b.disabled = true;
        b.textContent = "Loading…";
      }
      try {
        const u =
          "/api/home-more?seed=" +
          encodeURIComponent(seed) +
          "&offset=" +
          offset +
          "&limit=" +
          pageSize;
        const res = await fetch(u, { credentials: "same-origin" });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || "Load failed");
        const list = data.posts || [];
        const frag = document.createDocumentFragment();
        const wrap = document.createElement("div");
        for (const p of list) {
          wrap.innerHTML = cardHtml(p);
          if (wrap.firstChild) frag.appendChild(wrap.firstChild);
        }
        grid.appendChild(frag);
        offset = data.nextOffset != null ? data.nextOffset : offset + list.length;
        hasMore = !!data.hasMore;
        root.setAttribute("data-offset", String(offset));
        root.setAttribute("data-has-more", hasMore ? "1" : "0");
        updateCount(grid.querySelectorAll(".report-card").length);
        setFooter();
        if (hasMore) {
          const nb = footer.querySelector("[data-home-more-btn]");
          if (nb) {
            nb.disabled = false;
            nb.textContent = "Load more";
          }
        }
      } catch (err) {
        if (b) {
          b.disabled = false;
          b.textContent = "Load more";
        }
        console.error(err);
      } finally {
        loading = false;
      }
    }

    function observe() {
      const s = footer.querySelector("[data-home-more-sentinel]");
      if (!s || !("IntersectionObserver" in window)) return;
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            // Load more is explicit (batches of 16); sentinel keeps the footer in view.
            if (e.isIntersecting && hasMore && !loading) {
              /* keep button visible; no auto-fetch */
            }
          }
        },
        { rootMargin: "200px" }
      );
      io.observe(s);
    }

    if (btn) btn.addEventListener("click", loadMore);
    observe();
  })();
</script>
