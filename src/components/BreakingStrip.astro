---
import ReportCard from "~/components/ReportCard.astro";
import BreakingGroupCard from "~/components/BreakingGroupCard.astro";
import type { CollectionEntry } from "astro:content";

type Item =
  | { kind: "post"; post: CollectionEntry<"posts"> }
  | { kind: "group"; slug: string; title: string; topic?: string; members: CollectionEntry<"posts">[] };

interface Props {
  items: Item[];
  locked?: boolean;
  /** Post id unlocked as today's free sample for restricted readers. */
  unlockedId?: string | null;
  /** First story is a full-bleed plate; rest stay the strip. */
  leadCover?: boolean;
  /** Cover must be a full-frame landscape video — not items[0] if that is a Short. */
  coverLead?: Item | null;
}
const { items, locked = false, unlockedId = null, leadCover = false, coverLead = undefined } = Astro.props;
const lead = leadCover ? (coverLead !== undefined ? coverLead : items[0] ?? null) : null;
const stripItems = lead
  ? items.filter((it) => {
      if (it === lead) return false;
      if (lead.kind === "post" && it.kind === "post") return it.post.id !== lead.post.id;
      if (lead.kind === "group" && it.kind === "group") return it.slug !== lead.slug;
      return true;
    })
  : items;
---
{items.length > 0 && (
  <section class:list={["hero", "hero--breaking", lead && "hero--breaking-cover"]}>
    {lead && (
      <div class="hero-cover">
        {lead.kind === "group" ? (
          <BreakingGroupCard slug={lead.slug} title={lead.title} topic={lead.topic} members={lead.members} locked={locked} peek={false} ambientPlay />
        ) : (
          <ReportCard post={lead.post} locked={locked && lead.post.id !== unlockedId} sample={locked && lead.post.id === unlockedId} ambientPlay />
        )}
      </div>
    )}
    {stripItems.length > 0 && (
      <>
        <div class="hero__head">
          <div class="hero__head-text">
            <h2 class="small-caps">Breaking</h2>
          </div>
        </div>
        <div class="hero-strip-wrap">
          <button type="button" class="hero-arrow hero-arrow--left" aria-label="Scroll left" hidden>‹</button>
          <div class="hero-strip" aria-label="Breaking News reports">
            {stripItems.map((it) => (
              <div class="hero-strip__item hero-strip__item--peek">
                {it.kind === "group" ? (
                  <BreakingGroupCard slug={it.slug} title={it.title} topic={it.topic} members={it.members} locked={locked} peek />
                ) : (
                  <ReportCard post={it.post} locked={locked && it.post.id !== unlockedId} sample={locked && it.post.id === unlockedId} peek />
                )}
              </div>
            ))}
          </div>
          <button type="button" class="hero-arrow hero-arrow--right" aria-label="Scroll right">›</button>
        </div>
      </>
    )}
  </section>
)}

