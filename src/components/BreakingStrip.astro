---
import ReportCard from "~/components/ReportCard.astro";
import BreakingGroupCard from "~/components/BreakingGroupCard.astro";
import type { CollectionEntry } from "astro:content";

type Item =
  | { kind: "post"; post: CollectionEntry<"posts"> }
  | { kind: "group"; slug: string; title: string; topic?: string; members: CollectionEntry<"posts">[] };

interface Props {
  items: Item[];
  locked?: boolean;
  /** Post id unlocked as today's free sample for restricted readers. */
  unlockedId?: string | null;
  /** First story is a full-bleed plate; rest stay the strip. */
  leadCover?: boolean;
}
const { items, locked = false, unlockedId = null, leadCover = false } = Astro.props;
const lead = leadCover ? items[0] ?? null : null;
const stripItems = lead ? items.slice(1) : items;
---
{items.length > 0 && (
  <section class:list={["hero", "hero--breaking", lead && "hero--breaking-cover"]}>
    {lead && (
      <div class="hero-cover">
        {lead.kind === "group" ? (
          <BreakingGroupCard slug={lead.slug} title={lead.title} topic={lead.topic} members={lead.members} locked={locked} ambientPlay />
        ) : (
          <ReportCard post={lead.post} locked={locked && lead.post.id !== unlockedId} sample={locked && lead.post.id === unlockedId} ambientPlay />
        )}
      </div>
    )}
    {stripItems.length > 0 && (
      <>
        <div class="hero__head">
          <div class="hero__head-text">
            <h2 class="small-caps">Breaking</h2>
          </div>
        </div>
        <div class="hero-strip-wrap">
          <button type="button" class="hero-arrow hero-arrow--left" aria-label="Scroll left" hidden>‹</button>
          <div class="hero-strip" aria-label="Breaking News reports">
            {stripItems.map((it) => (
              <div class="hero-strip__item hero-strip__item--peek">
                {it.kind === "group" ? (
                  <BreakingGroupCard slug={it.slug} title={it.title} topic={it.topic} members={it.members} locked={locked} peek />
                ) : (
                  <ReportCard post={it.post} locked={locked && it.post.id !== unlockedId} sample={locked && it.post.id === unlockedId} peek />
                )}
              </div>
            ))}
          </div>
          <button type="button" class="hero-arrow hero-arrow--right" aria-label="Scroll right">›</button>
        </div>
      </>
    )}
  </section>
)}
{lead && (
  <script is:inline>
    (() => {
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      var frames = document.querySelectorAll(".hero-cover [data-ambient-src]");
      if (!frames.length) return;
      function cmd(el, fn, args) {
        try {
          if (!el.contentWindow) return;
          el.contentWindow.postMessage(
            JSON.stringify({ event: "command", func: fn, args: args || [] }),
            "*"
          );
        } catch (e) {}
      }
      function listen(el) {
        try {
          if (!el.contentWindow) return;
          el.contentWindow.postMessage(
            JSON.stringify({ event: "listening", id: 1, channel: "widget" }),
            "*"
          );
        } catch (e) {}
      }
      function reveal(el) {
        var photo = el.closest(".report-card__photo");
        if (!photo || photo.dataset.ambientReveal) return;
        photo.dataset.ambientReveal = "1";
        // YouTube paints pause + bezel for ~1s on start. Hold the still over it.
        setTimeout(function () {
          photo.classList.add("is-ambient-live");
        }, 2000);
      }
      function load(el) {
        if (el.getAttribute("src")) return;
        var src = el.getAttribute("data-ambient-src");
        if (!src) return;
        if (src.indexOf("origin=") === -1) {
          src += "&origin=" + encodeURIComponent(location.origin);
        }
        el.setAttribute("src", src);
        el.addEventListener("load", function () {
          listen(el);
          cmd(el, "mute");
          reveal(el);
        }, { once: true });
      }
      if (!("IntersectionObserver" in window)) {
        frames.forEach(load);
        return;
      }
      var io = new IntersectionObserver(function (ents) {
        ents.forEach(function (e) {
          var el = e.target;
          if (e.isIntersecting) {
            load(el);
            cmd(el, "mute");
            cmd(el, "playVideo");
          } else {
            cmd(el, "pauseVideo");
          }
        });
      }, { threshold: 0.2 });
      frames.forEach(function (f) { io.observe(f); });
      window.addEventListener("message", function (e) {
        var host = "";
        try { host = new URL(e.origin).hostname; } catch (err) { return; }
        if (host !== "www.youtube-nocookie.com" && host !== "www.youtube.com") return;
        var data = e.data;
        if (typeof data === "string") {
          try { data = JSON.parse(data); } catch (err) { return; }
        }
        if (!data || data.event !== "onStateChange") return;
        frames.forEach(function (el) {
          if (data.info === 1) reveal(el);
          if (data.info === 0) {
            cmd(el, "seekTo", [0, true]);
            cmd(el, "mute");
            cmd(el, "playVideo");
          }
        });
      });
    })();
  </script>
)}
