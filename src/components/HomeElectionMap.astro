---
/**
 * View-only Midterms 2026 map teaser for the homepage.
 * Map stage + side rails (stats / legend + flip watch); whole card deep-links to the full map.
 * Optional “next race” blurb renders under the map when races are provided.
 */
import type { CollectionEntry } from "astro:content";
import { env } from "cloudflare:workers";
import type { RaceDef } from "~/lib/races";
import HomeNextElection from "~/components/HomeNextElection.astro";
import { US_MAP_VIEWBOX, US_STATE_CODES, US_STATE_PATHS, US_STATE_NAMES } from "~/lib/usMapPaths";
import { buildStateForecasts, type Rating } from "~/lib/electionForecast";
import { getElectionForecastLive } from "~/lib/agents";

interface Props {
  races?: RaceDef[] | null;
  posts?: CollectionEntry<"posts">[];
}
const { races = null, posts = [] } = Astro.props;

const forecastLive = await getElectionForecastLive(env.AGENTS);
const forecast = buildStateForecasts(forecastLive);
const FORECAST_ASOF = forecast.asOf;
const flipCount = US_STATE_CODES.filter((c) => forecast.byCode[c]?.control?.flipRisk).length;

const cells = US_STATE_CODES.map((code) => {
  const f = forecast.byCode[code]?.control;
  const rating: Rating = f?.rating ?? "no-race";
  return {
    code,
    name: US_STATE_NAMES[code] ?? code,
    d: US_STATE_PATHS[code]!,
    rating,
    flip: !!f?.flipRisk,
  };
});

/** Up to 3 flip-risk states, alphabetical by name — existing forecast flags only. */
const flipWatch = cells
  .filter((s) => s.flip)
  .sort((a, b) => a.name.localeCompare(b.name))
  .slice(0, 3);

const LEGEND: { rating: Rating; label: string }[] = [
  { rating: "solid-d", label: "Solid D" },
  { rating: "likely-d", label: "Likely D" },
  { rating: "lean-d", label: "Lean D" },
  { rating: "tossup", label: "Toss-up" },
  { rating: "lean-r", label: "Lean R" },
  { rating: "likely-r", label: "Likely R" },
  { rating: "solid-r", label: "Solid R" },
];

const mapHref = "/elections/map/";
---
<section class="home-emap" aria-labelledby="home-emap-title">
  <div class="feed__head">
    <h2 class="feed__title" id="home-emap-title">Midterms 2026</h2>
    <a class="category__more" href={mapHref}>Open interactive map →</a>
  </div>
  <div class="rule rule--double" aria-hidden="true"></div>

  {/*
    Card is a div (not a single wrapping <a>) so rails stay non-interactive labels
    and we can add real chip links later without nested-interactive HTML.
    Primary deep-link is the map stage + footer CTA.
  */}
  <div class="home-emap__card">
    <div class="home-emap__meta">
      <p class="home-emap__kicker small-caps">Party &amp; outlook · State control</p>
      <p class="home-emap__lede">
        Who holds power now and who is favored in 2026.
        <strong>{flipCount}</strong> flip-risk states marked.
        Snapshot as of {FORECAST_ASOF}.
      </p>
    </div>

    {/* Mobile-only thin stat strip (desktop uses left rail) */}
    <div class="home-emap__strip" aria-hidden="true">
      <span class="home-emap__strip-stat">
        <strong>{flipCount}</strong> flip-risk
      </span>
      <span class="home-emap__strip-sep" aria-hidden="true">·</span>
      <span class="home-emap__strip-asof">as of {FORECAST_ASOF}</span>
      <span class="home-emap__strip-sep" aria-hidden="true">·</span>
      <span class="home-emap__strip-layer">State control</span>
    </div>

    <div class="home-emap__stage">
      <aside class="home-emap__rail home-emap__rail--stats" aria-hidden="true">
        <p class="home-emap__rail-label small-caps">Flip risk</p>
        <p class="home-emap__rail-num">{flipCount}</p>
        <p class="home-emap__rail-unit">states</p>
        <p class="home-emap__rail-asof">
          <span class="home-emap__rail-asof-label">Snapshot</span>
          <span class="home-emap__rail-asof-date">{FORECAST_ASOF}</span>
        </p>
        <p class="home-emap__rail-layer small-caps">State control</p>
      </aside>

      <a
        class="home-emap__map"
        href={mapHref}
        aria-label="Open the interactive Midterms 2026 election map"
      >
        <svg
          class="home-emap__svg"
          viewBox={US_MAP_VIEWBOX}
          preserveAspectRatio="xMidYMid meet"
          role="presentation"
          focusable="false"
          aria-hidden="true"
        >
          <defs>
            <filter id="home-emap-flip-glow" x="-20%" y="-20%" width="140%" height="140%">
              <feDropShadow dx="0" dy="0" stdDeviation="1.1" flood-color="currentColor" flood-opacity="0.35" />
            </filter>
          </defs>
          <g class="home-emap__states">
            {cells.map((s) => (
              <path
                class={`home-emap__state home-emap__party--${s.rating}${s.flip ? " home-emap__state--flip" : ""}`}
                d={s.d}
              />
            ))}
          </g>
        </svg>
      </a>

      <aside class="home-emap__rail home-emap__rail--side" aria-hidden="true">
        <ul class="home-emap__legend home-emap__legend--rail">
          {LEGEND.map((item) => (
            <li>
              <i class={`home-emap__swatch home-emap__party--${item.rating}`}></i>
              {item.label}
            </li>
          ))}
          <li>
            <span class="home-emap__flip-key">— —</span>
            Flip risk
          </li>
        </ul>

        {flipWatch.length > 0 && (
          <div class="home-emap__watch">
            <p class="home-emap__watch-label small-caps">Watch</p>
            <ul class="home-emap__chips">
              {flipWatch.map((s) => (
                <li>
                  <span class="home-emap__chip" title={s.name}>
                    <span class="home-emap__chip-code">{s.code}</span>
                    <span class="home-emap__chip-name">{s.name}</span>
                  </span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </aside>
    </div>

    {/* Horizontal legend + chips under map on small screens */}
    <div class="home-emap__mobile-foot" aria-hidden="true">
      <ul class="home-emap__legend home-emap__legend--row">
        {LEGEND.map((item) => (
          <li>
            <i class={`home-emap__swatch home-emap__party--${item.rating}`}></i>
            {item.label}
          </li>
        ))}
        <li>
          <span class="home-emap__flip-key">— —</span>
          Flip risk
        </li>
      </ul>
      {flipWatch.length > 0 && (
        <div class="home-emap__watch home-emap__watch--row">
          <p class="home-emap__watch-label small-caps">Watch</p>
          <ul class="home-emap__chips home-emap__chips--row">
            {flipWatch.map((s) => (
              <li>
                <span class="home-emap__chip" title={s.name}>
                  <span class="home-emap__chip-code">{s.code}</span>
                  <span class="home-emap__chip-name">{s.name}</span>
                </span>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>

    <p class="home-emap__cta-wrap">
      <a class="home-emap__cta small-caps" href={mapHref}>
        Explore layers · tap states · full map <span aria-hidden="true">→</span>
      </a>
    </p>
  </div>

  {races && races.length > 0 && (
    <HomeNextElection races={races} posts={posts} />
  )}
</section>
