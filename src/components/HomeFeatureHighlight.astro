---
/**
 * Home feature strip:
 * - variant "media" (default): horizontal media-hero cards (People in the news)
 * - variant "titles": thin auto-ticker title bar (Today on home; no visible section head)
 */
import type { HomeFeatureItem } from "~/lib/homeFeatures";
import { todayIsoNy } from "~/lib/calendarEvents";

interface Props {
  items: HomeFeatureItem[];
  class?: string;
  title?: string;
  /** Override default day-page link in the section head. */
  moreHref?: string;
  moreLabel?: string;
  /** Distinct id when multiple strips share the page (loop scripts). */
  stripId?: string;
  /** "media" = hero cards; "titles" = thin scrolling title bar. */
  variant?: "media" | "titles";
}
const {
  items,
  title = "Today",
  moreHref,
  moreLabel,
  stripId = "home-features",
  variant = "media",
} = Astro.props;
const today = todayIsoNy();
const multi = items.length > 1;
const isTitles = variant === "titles";
const headMoreHref = moreHref ?? `/day/${today}/`;
const headMoreLabel = moreLabel ?? "Full day →";
const titleId = `${stripId}-title`;
const wrapClass = [
  "home-features",
  isTitles ? "home-features--titles" : "",
  Astro.props.class,
]
  .filter(Boolean)
  .join(" ");

/** Short kicker for non-post desk/daybook items only. */
function shortKicker(h: HomeFeatureItem): string | null {
  if (h.id.startsWith("post-")) return null;
  const raw = (h.kicker || "").trim();
  if (!raw) return null;
  // First segment before · or —; cap length for the bar.
  const part = raw.split(/\s*[·•—–|]\s*/)[0]?.trim() || raw;
  if (part.length <= 14) return part;
  return part.slice(0, 12).trimEnd() + "…";
}
---
{items.length > 0 && (
  <section class={wrapClass} aria-label={title} data-home-features data-hf-root={stripId} data-hf-variant={variant}>
    {isTitles ? (
      <h2 class="visually-hidden" id={titleId}>{title}</h2>
    ) : (
      <>
        <div class="feed__head home-features__head">
          <h2 class="feed__title" id={titleId}>{title}</h2>
          <a class="category__more" href={headMoreHref}>{headMoreLabel}</a>
        </div>
        <div class="rule rule--double" aria-hidden="true"></div>
      </>
    )}

    {isTitles ? (
      <div
        class:list={["today-title-bar", multi && "today-title-bar--ticker"]}
        data-today-title-bar
      >
        <div class="today-title-bar__fade-wrap">
          <div
            class="today-title-bar__track"
            data-today-title-track
            style={multi ? `--n:${items.length}` : undefined}
          >
            {/* Primary set: real list for a11y / crawlers. */}
            <div class="today-title-bar__set" role="list" aria-labelledby={titleId}>
              {items.map((h, i) => {
                const kicker = shortKicker(h);
                return (
                  <>
                    {i > 0 && (
                      <span class="today-title-bar__sep" aria-hidden="true">·</span>
                    )}
                    <a
                      class="today-title-bar__item"
                      role="listitem"
                      href={h.href}
                    >
                      {kicker && (
                        <span class="today-title-bar__kicker small-caps">{kicker}</span>
                      )}
                      <span class="today-title-bar__title">{h.title}</span>
                    </a>
                  </>
                );
              })}
            </div>
            {/* Duplicate set for seamless marquee; hidden from AT, not tabbable. */}
            {multi && (
              <div class="today-title-bar__set" aria-hidden="true">
                {items.map((h, i) => {
                  const kicker = shortKicker(h);
                  return (
                    <>
                      {i > 0 && (
                        <span class="today-title-bar__sep">·</span>
                      )}
                      <a class="today-title-bar__item" href={h.href} tabindex="-1">
                        {kicker && (
                          <span class="today-title-bar__kicker small-caps">{kicker}</span>
                        )}
                        <span class="today-title-bar__title">{h.title}</span>
                      </a>
                    </>
                  );
                })}
              </div>
            )}
          </div>
        </div>
      </div>
    ) : (
      <div class="home-features__wrap" data-home-features-wrap>
        {multi && (
          <button type="button" class="hero-arrow hero-arrow--left" data-hf-prev aria-label={`Previous ${title}`}>‹</button>
        )}
        <div
          class="home-features__strip"
          aria-labelledby={titleId}
          data-home-features-strip
          data-loop={multi ? "1" : "0"}
        >
          {items.map((h, i) => {
            const image = h.image || null;
            const mono = (h.monogram || "").trim();
            const slideClass = [
              "media-hero",
              "home-feature",
              "home-features__slide",
              image || mono ? "media-hero--has-image" : "media-hero--plain",
              mono ? "media-hero--has-mono" : "",
              h.variant && `home-feature--${h.variant}`,
              h.variant && `media-hero--${h.variant}`,
            ]
              .filter(Boolean)
              .join(" ");
            return (
              <article
                class={`home-features__item ${slideClass}`}
                data-home-feature={h.id}
                data-hf-slide
                aria-label={`${i + 1} of ${items.length}: ${h.title}`}
              >
                {(image || mono) && (
                  <div class="media-hero__bg" aria-hidden="true">
                    {mono && <span class="media-hero__mono">{mono}</span>}
                    {image && (
                      <img
                        src={image}
                        alt=""
                        width="960"
                        height="540"
                        loading={i === 0 ? "eager" : "lazy"}
                        decoding="async"
                        onerror="this.remove()"
                      />
                    )}
                  </div>
                )}
                <div class="media-hero__scrim" aria-hidden="true"></div>
                <div class="media-hero__content home-feature__inner">
                  <div class="home-feature__text">
                    <p class="home-feature__kicker media-hero__kicker small-caps">{h.kicker}</p>
                    <h3 class="home-feature__title media-hero__title">{h.title}</h3>
                    {h.body && <p class="home-feature__body media-hero__body">{h.body}</p>}
                  </div>
                  <div class="home-feature__actions media-hero__actions">
                    <a class="home-feature__cta media-hero__cta" href={h.href}>{h.cta}</a>
                    {h.secondaryHref && h.secondaryCta && (
                      <a class="home-feature__secondary media-hero__secondary" href={h.secondaryHref}>
                        {h.secondaryCta}
                      </a>
                    )}
                  </div>
                </div>
              </article>
            );
          })}
        </div>
        {multi && (
          <button type="button" class="hero-arrow hero-arrow--right" data-hf-next aria-label="Next highlights">›</button>
        )}
      </div>
    )}
  </section>
)}

{!isTitles && multi && (
  <script is:inline>
    (() => {
      // Bind every unbound media strip (Today media path + politician spotlight, etc.).
      const roots = Array.from(document.querySelectorAll("[data-home-features]"));
      for (const root of roots) {
      if (root.dataset.loopBound === "1") continue;
      if (root.dataset.hfVariant === "titles") continue;
      root.dataset.loopBound = "1";

      const strip = root.querySelector("[data-home-features-strip]");
      const prev = root.querySelector("[data-hf-prev]");
      const next = root.querySelector("[data-hf-next]");
      if (!strip || strip.dataset.loop !== "1") continue;

      const originals = Array.from(strip.querySelectorAll("[data-hf-slide]"));
      if (originals.length < 2) continue;

      // Duplicate the set once for seamless wrap.
      const frag = document.createDocumentFragment();
      originals.forEach((el) => {
        const clone = el.cloneNode(true);
        clone.setAttribute("aria-hidden", "true");
        clone.querySelectorAll("img[loading=eager]").forEach((img) => {
          img.setAttribute("loading", "lazy");
        });
        frag.appendChild(clone);
      });
      strip.appendChild(frag);

      let setWidth = 0;
      let jumping = false;
      const reduce = () =>
        matchMedia("(prefers-reduced-motion: reduce)").matches;

      const measure = () => {
        const slides = strip.querySelectorAll("[data-hf-slide]");
        const n = originals.length;
        if (slides.length < n * 2) return;
        const first = slides[0];
        const mid = slides[n];
        if (!first || !mid) return;
        setWidth = mid.offsetLeft - first.offsetLeft;
      };

      const jumpIfNeeded = () => {
        if (!setWidth || jumping) return;
        const x = strip.scrollLeft;
        if (x >= setWidth - 1) {
          jumping = true;
          strip.scrollLeft = x - setWidth;
          jumping = false;
        }
      };

      const step = () =>
        Math.max(260, Math.min(setWidth || 400, strip.clientWidth * 0.85));

      const go = (dir) => {
        measure();
        if (!setWidth) return;
        const behavior = reduce() ? "auto" : "smooth";
        if (dir < 0 && strip.scrollLeft <= 6) {
          jumping = true;
          strip.scrollLeft = setWidth + strip.scrollLeft;
          jumping = false;
        }
        strip.scrollBy({ left: dir * step(), behavior });
        window.setTimeout(jumpIfNeeded, reduce() ? 0 : 450);
      };

      prev && prev.addEventListener("click", () => go(-1));
      next && next.addEventListener("click", () => go(1));

      strip.addEventListener(
        "scroll",
        () => {
          if (jumping) return;
          if (strip._hfRaf) return;
          strip._hfRaf = requestAnimationFrame(() => {
            strip._hfRaf = 0;
            jumpIfNeeded();
          });
        },
        { passive: true }
      );

      strip.addEventListener("scrollend", () => jumpIfNeeded(), { passive: true });

      if (prev) prev.hidden = false;
      if (next) next.hidden = false;

      const boot = () => {
        measure();
        if (setWidth > 0) strip.scrollLeft = 0;
      };
      requestAnimationFrame(() => {
        boot();
        requestAnimationFrame(boot);
      });
      window.addEventListener("resize", () => {
        const frac = setWidth ? (strip.scrollLeft % setWidth) / setWidth : 0;
        measure();
        if (setWidth) strip.scrollLeft = frac * setWidth;
      });

      strip.querySelectorAll("img").forEach((img) => {
        if (!img.complete) img.addEventListener("load", measure, { once: true });
      });
      } // end for roots
    })();
  </script>
)}
